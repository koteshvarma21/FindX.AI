# Copy this file to .env and fill in your real values. Never commit .env itself.

PORT=5000

# MongoDB connection (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/findx_ai
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/findx_ai

OPENAI_API_KEY=your_openai_api_key_here
JWT_SECRET=replace_with_a_long_random_string

# AI service (image generation / matching / vision)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.featherless.ai/v1
AI_MODEL=qwen/qwen3-32b
AI_EMBEDDING_MODEL=nomic-embed-text-v1.5

# Email notifications (used by the mail service once it's wired up)
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_app_password

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
